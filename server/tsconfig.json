{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ESNext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["../server", "../shared"]
}
