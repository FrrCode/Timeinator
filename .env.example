# Site identity. Every value is optional — unset ones fall back to the defaults
# in src/lib/consts.ts, which describe the canonical deployment.
#
# Self-hosting? Copy this file to .env.local and set at least VITE_SITE_URL, so
# the canonical link and the social card image point at your own host. These are
# read at build time, so re-run `pnpm run build` after changing them.

# Origin the build is served from. Trailing slashes are trimmed.
VITE_SITE_URL=https://timeinator.example.com

# Browser tab title and <meta name="description">.
# VITE_SITE_NAME=Timeinator
# VITE_SITE_TITLE=Timeinator - Time Converter and World Clock.
# VITE_SITE_DESCRIPTION=Easy time convertion. Compare time across timezones.

# Link-preview headline, and the card image. The image may be an absolute URL or
# a path resolved against VITE_SITE_URL.
# VITE_SITE_OG_TITLE=Timeinator - Convert Time
# VITE_SITE_OG_IMAGE=/og-image.jpeg

# Installed-app metadata: the name under the home-screen icon, the browser
# chrome colour, and the splash-screen background.
# VITE_SITE_SHORT_NAME=Timeinator
# VITE_SITE_THEME_COLOR=#2196f3
# VITE_SITE_BACKGROUND_COLOR=#ffffff

# --- Pick Time server ---
# The Pick Time page needs the Node server (`pnpm build && pnpm start`), which
# serves both the built app and /api. These are read at runtime, not build time.

# Port the server listens on. Default 4002.
# PORT=4002

# Directory holding timeinator.db. Created if missing. Default ./data
# DATA_DIR=./data
