{
	"name": "timeinator",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "concurrently -n web,api -c cyan,magenta \"vite --port 4001 --host\" \"pnpm dev:api\"",
		"dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
		"build": "tsc --noEmit && tsc -p server --noEmit && vite build",
		"start": "node --disable-warning=ExperimentalWarning server/index.ts",
		"preview": "vite preview --port 4001",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "biome ci .",
		"fix": "biome check --write .",
		"changelog": "node scripts/changelog.ts",
		"screenshots": "node --disable-warning=ExperimentalWarning scripts/screenshots.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"cmdk": "^1.1.1",
		"hono": "^4.13.5"
	},
	"devDependencies": {
		"@base-ui/react": "^1.7.0",
		"@biomejs/biome": "^2.5.8",
		"@date-fns/tz": "^1.5.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.3.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"date-fns": "^4.4.0",
		"dayjs": "^1.11.10",
		"lucide-react": "1.34.0",
		"playwright-core": "^1.62.1",
		"react": "^19.1.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.1.0",
		"react-router-dom": "^7.1.1",
		"shadcn": "^4.19.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"vite": "^6.0.7",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11",
		"workbox-window": "^7.4.1"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"pnpm": {
		"overrides": {
			"fastq": "1.20.1",
			"systeminformation": "5.33.4"
		}
	}
}
